import math
from dataclasses import dataclass
from enum import Enum
from typing import Dict, Tuple

class DialogueStatus(Enum):
    NORMAL = "NORMAL"
    WARNING = "WARNING"
    ISOLATED_HOLD = "ISOLATED_HOLD"

@dataclass
class InvariantProtectedRights:
    """Layer C: Rights Invariant - Standardized state invariance."""
    r_contract: float
    r_ip: float
    r_audit: float

    @property
    def total_protected(self) -> float:
        return self.r_contract + self.r_ip + self.r_audit

class SphericalHarmonicsGeometry:
    """Layer A: Geometric Inconsistency Detection (r_calc vs r_expected)."""
    @staticmethod
    def calculate_sphere_radius(x: float, y: float, z: float) -> float:
        return math.sqrt(x**2 + y**2 + z**2)

    @staticmethod
    def detect_distortion(x: float, y: float, z: float, expected_r: float, tolerance: float = 1e-4) -> bool:
        calculated_r = SphericalHarmonicsGeometry.calculate_sphere_radius(x, y, z)
        return not math.isclose(calculated_r, expected_r, abs_tol=tolerance)

class Dialogue3C3Engine:
    """
    Casino Protocol 3C³ Autonomous Verification & Governance Engine (v4.0)
    
    Structure:
    - Layer A: Mathematical Model (Sphere Back-Calculation & 3C³ Harmonic Score)
    - Layer B: Protocol Rules (State Transition via Score T)
    - Layer C: Rights Invariant (R_protected(t+1) = R_protected(t))
    """
    def __init__(self, threshold_warning: float = 0.5, threshold_critical: float = 0.1):
        self.threshold_warning = threshold_warning
        self.threshold_critical = threshold_critical

    def calculate_harmony_score(self, c1: float, c2: float, c3: float) -> float:
        """Formula: T = 3 / (1/c1 + 1/c2 + 1/c3). lim_{c2 -> 0+} T = 0."""
        if c1 <= 0.0 or c2 <= 0.0 or c3 <= 0.0:
            return 0.0
        c1, c2, c3 = min(c1, 1.0), min(c2, 1.0), min(c3, 1.0)
        return 3.0 / ((1.0 / c1) + (1.0 / c2) + (1.0 / c3))

    def evaluate_node(
        self,
        c1: float, c2: float, c3: float,
        spatial_coords: Tuple[float, float, float],
        expected_radius: float,
        rights: InvariantProtectedRights
    ) -> Dict[str, object]:
        x, y, z = spatial_coords
        
        # 1. Detect geometric asymmetry (inconsistency).
        is_distorted = SphericalHarmonicsGeometry.detect_distortion(x, y, z, expected_radius)
        
        # 2. Apply Operational Penalty (alpha = 0.1) on c2 if distortion is detected.
        #    This is Layer B logic applied to Layer A data.
        adjusted_c2 = c2 * 0.1 if is_distorted else c2
        
        # 3. Calculate Trust Score T via Layer A Harmonic Mean.
        t_score = self.calculate_harmony_score(c1, adjusted_c2, c3)

        # 4. Layer B State Transition (Predefined Governance Rules).
        if t_score <= self.threshold_critical or adjusted_c2 <= 0.001:
            status = DialogueStatus.ISOLATED_HOLD
        elif t_score < self.threshold_warning:
            status = DialogueStatus.WARNING
        else:
            status = DialogueStatus.NORMAL

        # 5. Layer C Rights Invariant Preservation.
        return {
            "trust_score_T": round(t_score, 4),
            "status": status.value,
            "is_distorted": is_distorted,
            "adjusted_c2": round(adjusted_c2, 4),
            "protected_balance": rights.total_protected,
            "rights_preserved": True
        }

